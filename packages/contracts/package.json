        }
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --clean",
        "test": "node --test tests/runtime.test.mjs"
    },
    "dependencies": {
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "tsup": "^8.5.0",
        "typescript": "^5.2.2"
    }
}
