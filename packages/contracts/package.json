{
    "name": "@inventory-system/contracts",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
