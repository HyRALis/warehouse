{
    "info": {
        "name": "Templates API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
        { "key": "authToken", "value": "", "type": "string" },
        { "key": "templateId", "value": "", "type": "string" }
    ],
    "item": [
        {
            "name": "List Templates",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/templates",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "v1", "templates"]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
                }
            },
            "response": [
                {
                    "name": "Success",
                    "code": 200,
                    "body": "{\n  \"success\": true,\n  \"data\": []\n}"
                }
            ]
        },
        {
            "name": "Get Template by ID",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/templates/{{templateId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "v1", "templates", "{{templateId}}"]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
                }
            },
            "response": [
                {
                    "name": "Success",
                    "code": 200,
                    "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"name\": \"Food Template\"\n  }\n}"
                }
            ]
        },
        {
            "name": "Create Template",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                            "    pm.collectionVariables.set('templateId', jsonData.data.id);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Food Template\",\n  \"fields\": [\n    {\"name\": \"Weight\", \"measurement\": \"g\"},\n    {\"name\": \"Expiry Date\", \"measurement\": \"date\"}\n  ]\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/v1/templates",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "v1", "templates"]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
                }
            },
            "response": [
                {
                    "name": "Created",
                    "code": 201,
                    "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"name\": \"Food Template\"\n  }\n}"
                }
            ]
        },
        {
            "name": "Update Template",
            "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Updated Food Template\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/v1/templates/{{templateId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "v1", "templates", "{{templateId}}"]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
                }
            },
            "response": [
                {
                    "name": "Success",
                    "code": 200,
                    "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"name\": \"Updated Food Template\"\n  }\n}"
                }
            ]
        },
        {
            "name": "Delete Template",
            "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/templates/{{templateId}}",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "v1", "templates", "{{templateId}}"]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
                }
            },
            "response": [
                {
                    "name": "Success",
                    "code": 200,
                    "body": "{\n  \"success\": true,\n  \"message\": \"Template deleted successfully\"\n}"
                }
            ]
        }
    ]
}
