{
  "info": {
    "name": "Categories API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "List Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/categories",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "categories"]
        },
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
        }
      },
      "response": [{ "name": "Success", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": []\n}" }]
    },
    {
      "name": "Create Category",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.id) {",
              "    pm.collectionVariables.set('categoryId', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Organic Food\",\n  \"parentId\": \"optional-uuid\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/categories",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "categories"]
        },
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
        }
      },
      "response": [{ "name": "Created", "code": 201, "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"name\": \"Organic Food\"\n  }\n}" }]
    },
    {
      "name": "Update Category",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Name\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "categories", "{{categoryId}}"]
        },
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
        }
      },
      "response": [{ "name": "Success", "code": 200, "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"name\": \"Updated Name\"\n  }\n}" }]
    },
    {
      "name": "Delete Category",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/categories/{{categoryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "categories", "{{categoryId}}"]
        },
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
        }
      },
      "response": [
        { "name": "Success", "code": 200, "body": "{\n  \"success\": true,\n  \"message\": \"Category deleted successfully\"\n}" },
        { "name": "Has Products", "code": 400, "body": "{\n  \"message\": \"Category contains products\",\n  \"code\": \"BAD_REQUEST\",\n  \"statusCode\": 400\n}" }
      ]
    }
  ]
}
