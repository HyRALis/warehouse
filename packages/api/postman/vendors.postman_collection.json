{
    "info": {
        "name": "Vendors API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
        { "key": "authToken", "value": "", "type": "string" }
    ],
    "item": [
        {
            "name": "Update Profile",
            "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"companyName\": \"New Name\",\n  \"email\": \"new@example.com\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/v1/vendors/me",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "v1", "vendors", "me"]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
                }
            },
            "response": [
                {
                    "name": "Success",
                    "code": 200,
                    "body": "{\n  \"success\": true,\n  \"data\": {\n    \"companyName\": \"New Name\",\n    \"email\": \"new@example.com\"\n  }\n}"
                }
            ]
        },
        {
            "name": "Delete Account",
            "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/vendors/me",
                    "host": ["{{baseUrl}}"],
                    "path": ["api", "v1", "vendors", "me"]
                },
                "auth": {
                    "type": "bearer",
                    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
                }
            },
            "response": [
                {
                    "name": "Success",
                    "code": 200,
                    "body": "{\n  \"success\": true,\n  \"message\": \"Account deleted successfully\"\n}"
                }
            ]
        }
    ]
}
