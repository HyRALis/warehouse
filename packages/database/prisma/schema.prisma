generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

enum PortalSubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model User {
  id                  String               @id
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  twoFactorEnabled    Boolean?             @default(false)
  sessions            Session[]
  accounts            Account[]
  members             Member[]
  invitations         Invitation[]
  twoFactors          TwoFactor[]
  grantedPortalAccess MemberPortalAccess[] @relation("PortalAccessGrantedBy")
  updatedPortalAccess MemberPortalAccess[] @relation("PortalAccessUpdatedBy")

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime
  metadata  String?

  members             Member[]
  invitations         Invitation[]
  portalSubscriptions OrganizationPortalSubscription[]
  vendorProfiles      VendorProfile[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  portalAccess MemberPortalAccess[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Portal {
  key         String   @id
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscriptions OrganizationPortalSubscription[]
  memberAccess  MemberPortalAccess[]

  @@map("portals")
}

model OrganizationPortalSubscription {
  id             String                   @id @default(uuid())
  organizationId String                   @map("organization_id")
  portalKey      String                   @map("portal_key")
  status         PortalSubscriptionStatus @default(ACTIVE)
  startsAt       DateTime                 @default(now()) @map("starts_at")
  endsAt         DateTime?                @map("ends_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portal       Portal       @relation(fields: [portalKey], references: [key], onDelete: Restrict)

  @@unique([organizationId, portalKey])
  @@index([portalKey, status])
  @@map("organization_portal_subscriptions")
}

model MemberPortalAccess {
  id              String   @id @default(uuid())
  memberId        String   @map("member_id")
  portalKey       String   @map("portal_key")
  enabled         Boolean  @default(true)
  grantedByUserId String?  @map("granted_by_user_id")
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  portal    Portal @relation(fields: [portalKey], references: [key], onDelete: Restrict)
  grantedBy User?  @relation("PortalAccessGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("PortalAccessUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([memberId, portalKey])
  @@index([portalKey, enabled])
  @@index([grantedByUserId])
  @@index([updatedByUserId])
  @@map("member_portal_access")
}

model VendorProfile {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  profileKey     String    @default("primary") @map("profile_key")
  displayName    String    @map("display_name")
  description    String?
  websiteUrl     String?   @map("website_url")
  logoUrl        String?   @map("logo_url")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products                Product[]
  productVersions         ProductVersion[]
  categories              Category[]
  characteristicTemplates CharacteristicTemplate[]

  @@unique([organizationId, profileKey])
  @@index([organizationId, deletedAt])
  @@map("vendor_profiles")
}

model Category {
  id                String   @id @default(uuid())
  code              String?  @unique
  name              String
  aliases           String[] @default([])
  searchText        String   @default("") @map("search_text")
  parentId          String?  @map("parent_id")
  vendorProfileId   String?  @map("vendor_profile_id")
  defaultTemplateId String?  @map("default_template_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  parent          Category?               @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]              @relation("CategoryHierarchy")
  vendorProfile   VendorProfile?          @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  defaultTemplate CharacteristicTemplate? @relation("CategoryDefaultTemplate", fields: [defaultTemplateId], references: [id], onDelete: SetNull)
  products        Product[]

  @@index([vendorProfileId])
  @@index([parentId])
  @@index([defaultTemplateId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "categories_search_text_trgm_idx")
  @@map("categories")
}

model Product {
  id              String        @id @default(uuid())
  vendorProfileId String        @map("vendor_profile_id")
  categoryId      String        @map("category_id")
  sku             String
  baseName        String        @map("base_name")
  imageUrl        String?       @map("image_url")
  barcode         String?
  qrCodeUrl       String?       @map("qr_code_url")
  status          ProductStatus @default(DRAFT)
  characteristics Json          @default("[]")
  searchText      String        @default("") @map("search_text")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  vendorProfile VendorProfile    @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  versions      ProductVersion[]

  @@unique([vendorProfileId, sku])
  @@index([vendorProfileId, deletedAt])
  @@index([categoryId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_search_text_trgm_idx")
  @@map("products")
}

model ProductVersion {
  id              String        @id @default(uuid())
  productId       String        @map("product_id")
  vendorProfileId String        @map("vendor_profile_id")
  versionNumber   Int           @map("version_number")
  label           String
  sku             String
  barcode         String?
  qrCodeUrl       String?       @map("qr_code_url")
  status          ProductStatus @default(DRAFT)
  characteristics Json          @default("[]")
  designNotes     String?       @map("design_notes")
  isPrimary       Boolean       @default(false) @map("is_primary")
  searchText      String        @default("") @map("search_text")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorProfile VendorProfile  @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  images        ProductImage[]

  @@unique([productId, versionNumber])
  @@unique([vendorProfileId, sku])
  @@unique([vendorProfileId, barcode])
  @@index([productId, deletedAt])
  @@index([vendorProfileId, deletedAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_versions_search_text_trgm_idx")
  @@map("product_versions")
}

model ProductImage {
  id               String   @id @default(uuid())
  productId        String   @map("product_id")
  productVersionId String?  @map("product_version_id")
  imageUrl         String   @map("image_url")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVersion ProductVersion? @relation(fields: [productVersionId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productVersionId])
  @@map("product_images")
}

model CharacteristicTemplate {
  id              String   @id @default(uuid())
  vendorProfileId String?  @map("vendor_profile_id")
  key             String?  @unique
  name            String
  fields          Json     @default("[]")
  searchText      String   @default("") @map("search_text")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  vendorProfile        VendorProfile? @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  defaultForCategories Category[]     @relation("CategoryDefaultTemplate")

  @@index([vendorProfileId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "characteristic_templates_search_text_trgm_idx")
  @@map("characteristic_templates")
}
