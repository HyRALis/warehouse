{
    "name": "inventory-system",
    "private": true,
    "packageManager": "npm@11.2.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "devDependencies": {
        "turbo": "2.10.8"
    },
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "db:seed": "npm run seed --workspace @inventory-system/database",
        "db:seed:verify": "npm run seed:verify --workspace @inventory-system/database",
        "audit:prod": "npm audit --omit=dev --audit-level=high"
    }
}
