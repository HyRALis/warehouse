{
    "name": "inventory-system",
    "private": true,
    "packageManager": "npm@11.6.2",
    "engines": {
        "node": ">=22 <25",
        "npm": ">=11"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "devDependencies": {
        "auth": "^1.7.2",
        "prisma": "7.10.0",
        "turbo": "2.10.8"
    },
    "overrides": {
        "deepmerge-ts": "8.0.2",
        "mysql2": "3.24.2"
    },
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "db:seed": "npm run seed --workspace @inventory-system/database",
        "db:seed:verify": "npm run seed:verify --workspace @inventory-system/database",
        "audit:prod": "npm audit --omit=dev --audit-level=high"
    }
}
