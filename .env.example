# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://inventory:inventory@localhost:5432/inventory?schema=public"
PRISMA_POOL_MAX_CONNECTIONS=10
PRISMA_POOL_CONNECTION_TIMEOUT_MS=5000
PRISMA_POOL_IDLE_TIMEOUT_MS=30000

# Generate a unique value with at least 32 characters; never commit the real secret.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
BETTER_AUTH_SECRET="replace-with-a-different-random-secret-of-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:4000"

PORT=4000
CORS_ORIGINS="http://localhost:3000"
API_PUBLIC_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
TRUST_PROXY=false
# Configure only when a trusted reverse proxy overwrites this header. Cloudflare uses
# cf-connecting-ip; local/other trusted proxies may use x-real-ip.
AUTH_CLIENT_IP_HEADER="cf-connecting-ip"

# Authentication email delivery. `log` records safe metadata but never tokens or links.
AUTH_EMAIL_MODE="log"
AUTH_EMAIL_FROM="OmniStock <no-reply@example.com>"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""

# Optional. Defaults to an uploads folder under the API process working directory.
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Production media storage (required when STORAGE_DRIVER=r2).
# R2_PUBLIC_URL should be the cache/CDN delivery origin, not the S3 API endpoint.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL="https://media.example.com"
